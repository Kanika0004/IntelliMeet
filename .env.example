# ---------- Google account ----------
# Recommended: sign in once manually into a dedicated Chrome profile and point to it here.
# Google often blocks scripted password logins, so a saved profile is far more reliable.
# Leave empty to use DATA_DIR/chrome-profile. Sign in from the web app: Settings -> Sign in bot.
CHROME_PROFILE_DIR=
# Optional: full path to chrome.exe if it is not found automatically
CHROME_BINARY=
# Optional fallback: scripted login (may trigger Google's "browser not secure" block)
EMAIL_ID=
EMAIL_PASSWORD=

# ---------- Meeting ----------
MEET_LINK=https://meet.google.com/xxx-xxxx-xxx
BOT_DISPLAY_NAME=IntelliMeet Bot
HEADLESS=false

# ---------- Recording ----------
RECORDING_DURATION=1800
SAMPLE_RATE=44100
CHANNELS=1
# Input device name or index. To capture meeting audio use a loopback device:
#   Linux: PulseAudio/PipeWire "Monitor of ..." source
#   Windows: "Stereo Mix" or VB-Audio Cable
#   macOS: BlackHole
# loopback = record system audio (default on Windows/Linux), device = input device below
AUDIO_SOURCE=
AUDIO_DEVICE=
MAX_AUDIO_SIZE_BYTES=20971520
OUTPUT_DIR=./recordings

# ---------- Transcription ----------
# openai = OpenAI Whisper API, local = faster-whisper on this machine
TRANSCRIBER=openai
WHISPER_MODEL=whisper-1
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu

# ---------- Analysis ----------
# auto (first key found), openai, gemini, or basic (offline, no key)
ANALYZER=auto
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Web app ----------
DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
